{
  "name": "webcreator-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "test": "npm run test:shared && npm run test:backend && npm run test:frontend",
    "test:shared": "npm run test --workspace=@webcreator/shared",
    "test:backend": "npm run test --workspace=@webcreator/backend",
    "test:frontend": "npm run test --workspace=@webcreator/frontend"
  }
}
